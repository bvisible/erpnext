#. Option for the 'Action if Annual Budget Exceeded on Actual' (Select) field
#. in DocType 'Budget'
#. Option for the 'Action if Accumulated Monthly Budget Exceeded on Actual'
#: erpnext/accounts/doctype/budget/budget.json
msgid "Ignore"
msgstr "Ignorer"

#. Label of a Check field in DocType 'Accounts Settings'
#: erpnext/accounts/doctype/accounts_settings/accounts_settings.json
msgid "Ignore Account Closing Balance"
msgstr "Ignorer le solde de clôture du compte"

#. Label of a Check field in DocType 'Production Plan'
#: erpnext/manufacturing/doctype/production_plan/production_plan.json
msgid "Ignore Available Stock"
msgstr "Ignorer le stock disponible"

#: erpnext/stock/report/stock_balance/stock_balance.js:125
msgid "Ignore Closing Balance"
msgstr "Ignorer le solde de clôture"

#. Label of a Check field in DocType 'Purchase Invoice'
#. Label of a Check field in DocType 'Sales Invoice'
#: erpnext/accounts/doctype/purchase_invoice/purchase_invoice.json
#: erpnext/accounts/doctype/sales_invoice/sales_invoice.json
msgid "Ignore Default Payment Terms Template"
msgstr "Ignorer le modèle de conditions de paiement par défaut"

#. Label of a Check field in DocType 'Projects Settings'
#: erpnext/projects/doctype/projects_settings/projects_settings.json
msgid "Ignore Employee Time Overlap"
msgstr "Ignorer les chevauchements de temps des employés"

#: erpnext/stock/doctype/stock_reconciliation/stock_reconciliation.js:143
msgid "Ignore Empty Stock"
msgstr "Ignorer le stock vide"

#. Label of a Check field in DocType 'Process Statement Of Accounts'
#: erpnext/accounts/doctype/process_statement_of_accounts/process_statement_of_accounts.json
#: erpnext/accounts/report/general_ledger/general_ledger.js:217
msgid "Ignore Exchange Rate Revaluation and Gain / Loss Journals"
msgstr ""
"Ignorer la réévaluation du taux de change et les journaux de gain / perte"

#: erpnext/selling/doctype/sales_order/sales_order.js:994
msgid "Ignore Existing Ordered Qty"
msgstr "Ignorer la quantité commandée existante"

#: erpnext/manufacturing/doctype/production_plan/production_plan.py:1679
msgid "Ignore Existing Projected Quantity"
msgstr "Ignorer la quantité projetée existante"

#. Label of a Check field in DocType 'Accounts Settings'
#: erpnext/accounts/doctype/accounts_settings/accounts_settings.json
msgid "Ignore Is Opening check for reporting"
msgstr "Ignorer la vérification « Est une ouverture » pour les rapports"

