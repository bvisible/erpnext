#: erpnext/accounts/doctype/payment_gateway_account/payment_gateway_account.json
#. Content of the 'Message Examples' (HTML) field in DocType 'Payment Gateway
#. Account'
msgid ""
"<pre><h5>Message Example</h5>\n"
"\n"
"&lt;p&gt; Thank You for being a part of {{ doc.company }}! We hope you are "
"enjoying the service.&lt;/p&gt;\n"
"\n"
"&lt;p&gt; Please find enclosed the E Bill statement. The outstanding amount "
"is {{ doc.grand_total }}.&lt;/p&gt;\n"
"\n"
"&lt;p&gt; We don't want you to be spending time running around in order to "
"pay for your Bill.<br>After all, life is beautiful and the time you have in "
"hand should be spent to enjoy it!<br>So here are our little ways to help "
"you get more time for life! &lt;/p&gt;\n"
"\n"
"&lt;a href=\"{{ payment_url }}\"&gt; click here to pay &lt;/a&gt;\n"
"\n"
"</pre>\n"
msgstr ""
"<pre><h5>Exemple de message</h5>\n"
"\n"
"&lt;p&gt; Merci de faire partie de {{ doc.company }} ! Nous espérons que "
"vous appréciez le service.&lt;/p&gt;\n"
"\n"
"&lt;p&gt; Veuillez trouver ci-joint le relevé de facture électronique. Le "
"montant restant dû est de {{ doc.grand_total }}.&lt;/p&gt;\n"
"\n"
"&lt;p&gt; Nous ne voulons pas que vous perdiez du temps à courir pour payer "
"votre facture.<br>Après tout, la vie est belle et le temps dont vous "
"disposez devrait être consacré à en profiter !<br>Voici donc nos petites "
"astuces pour vous faire gagner du temps ! &lt;/p&gt;\n"
"\n"
"&lt;a href=\"{{ payment_url }}\"&gt; cliquez ici pour payer &lt;/a&gt;\n"
"\n"
"</pre>\n"

#: erpnext/accounts/doctype/payment_request/payment_request.json
#. Content of the 'Message Examples' (HTML) field in DocType 'Payment Request'
msgid ""
"<pre><h5>Message Example</h5>\n"
"\n"
"&lt;p&gt;Dear {{ doc.contact_person }},&lt;/p&gt;\n"
"\n"
"&lt;p&gt;Requesting payment for {{ doc.doctype }}, {{ doc.name }} for {{ "
"doc.grand_total }}.&lt;/p&gt;\n"
"\n"
"&lt;a href=\"{{ payment_url }}\"&gt; click here to pay &lt;/a&gt;\n"
"\n"
"</pre>\n"
msgstr ""
"<pre><h5>Exemple de message</h5>\n"
"\n"
"&lt;p&gt;Cher {{ doc.contact_person }},&lt;/p&gt;\n"
"\n"
"&lt;p&gt;Demande de paiement pour {{ doc.doctype }}, {{ doc.name }} d'un "
"montant de {{ doc.grand_total }}.&lt;/p&gt;\n"
"\n"
"&lt;a href=\"{{ payment_url }}\"&gt; cliquez ici pour payer &lt;/a&gt;\n"
"\n"
"</pre>\n"

